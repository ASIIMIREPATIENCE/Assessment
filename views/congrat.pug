doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Congratulations
    link(rel='stylesheet' href='congrat.css')
    style.
      .container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 40vh;
        width: 50%;
        margin-top: 200px;
        margin-left: auto;
        margin-right: auto;
        padding: 50px;
        text-align: center;
        background-color: #35bdcc;
        color: #e6dbdb;
        font-family: Arial, sans-serif;
      }
      .get-started-btn {
        width: 100%;
        padding: 12px;
        background-color: #333;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        cursor: pointer;
        margin-top: 20px;
      }
      .get-started-btn:hover {
        background-color: purple;
      }
      a {
        text-decoration: none;
        width: 100%;
      }
  body
    .container
      h1 Congratulations!
      p You have successfully signed up for the Refactory system. Feel at home
      a(href='/dash')
        button.get-started-btn Get Started