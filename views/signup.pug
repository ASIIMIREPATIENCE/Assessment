doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Signup Form
  link(rel='stylesheet' href='/css/signup.css')

body
  .signup-box
    // Success message at the top (as shown in your image)
    if success
      .success-message #{success}
    
    h1 Signup
    
    form(id='signupForm' action='/signup' method='POST')
      .field
        input(type='text' id='fullname' name='fullname' placeholder='Full Name')
      
      .field
        input(type='email' id='email' name='email' placeholder='Email')
      
      .field
        input(type='tel' id='phone' name='phone' placeholder='Phone Number' maxlength='13')
      
      .field
        input(type='password' id='password' name='password' placeholder='Password')
      
      .field
        input(type='password' id='confirmPassword' name='confirmPassword' placeholder='Confirm Password')
      
      button(type='submit') SIGNUP
      
      .login-link
        | Have an account? 
        a(href='/login') -Login

script.
  const form = document.getElementById('signupForm');
  
  function validateField(field) {
    if (!field.value.trim()) {
      field.style.borderColor = '#dc2626';
      return false;
    } else {
      field.style.borderColor = '#10b981';
      return true;
    }
  }
  
  function validateEmail(field) {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!field.value.trim()) {
      field.style.borderColor = '#dc2626';
      return false;
    } else if (!emailRegex.test(field.value.trim())) {
      field.style.borderColor = '#dc2626';
      return false;
    } else {
      field.style.borderColor = '#10b981';
      return true;
    }
  }
  
  function validatePhone(field) {
    const phoneRegex = /^\+256[0-9]{9}$/;
    if (!field.value.trim()) {
      field.style.borderColor = '#dc2626';
      return false;
    } else if (!phoneRegex.test(field.value.trim())) {
      field.style.borderColor = '#dc2626';
      return false;
    } else {
      field.style.borderColor = '#10b981';
      return true;
    }
  }
  
  function validatePasswordMatch(passwordField, confirmField) {
    if (!confirmField.value.trim()) {
      confirmField.style.borderColor = '#dc2626';
      return false;
    } else if (passwordField.value !== confirmField.value) {
      passwordField.style.borderColor = '#dc2626';
      confirmField.style.borderColor = '#dc2626';
      return false;
    } else {
      passwordField.style.borderColor = '#10b981';
      confirmField.style.borderColor = '#10b981';
      return true;
    }
  }
  
  document.getElementById('fullname').addEventListener('input', function() {
    if (this.value.trim()) {
      this.style.borderColor = '#10b981';
    } else {
      this.style.borderColor = '#32d0cb';
    }
  });
  
  document.getElementById('email').addEventListener('input', function() {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (this.value.trim() && emailRegex.test(this.value.trim())) {
      this.style.borderColor = '#10b981';
    } else if (this.value.trim()) {
      this.style.borderColor = '#dc2626';
    } else {
      this.style.borderColor = '#32d0cb';
    }
  });
  
  document.getElementById('phone').addEventListener('input', function() {
    const phoneRegex = /^\+256[0-9]{9}$/;
    if (this.value.trim() && phoneRegex.test(this.value.trim())) {
      this.style.borderColor = '#10b981';
    } else if (this.value.trim()) {
      this.style.borderColor = '#dc2626';
    } else {
      this.style.borderColor = '#32d0cb';
    }
  });
  
  document.getElementById('password').addEventListener('input', function() {
    if (this.value.trim()) {
      this.style.borderColor = '#10b981';
    } else {
      this.style.borderColor = '#32d0cb';
    }
    const confirmField = document.getElementById('confirmPassword');
    if (confirmField.value.trim()) {
      if (this.value === confirmField.value) {
        this.style.borderColor = '#10b981';
        confirmField.style.borderColor = '#10b981';
      } else {
        this.style.borderColor = '#dc2626';
        confirmField.style.borderColor = '#dc2626';
      }
    }
  });
  
  document.getElementById('confirmPassword').addEventListener('input', function() {
    const passwordField = document.getElementById('password');
    if (this.value.trim() && this.value === passwordField.value) {
      this.style.borderColor = '#10b981';
      passwordField.style.borderColor = '#10b981';
    } else if (this.value.trim()) {
      this.style.borderColor = '#dc2626';
      passwordField.style.borderColor = '#dc2626';
    } else {
      this.style.borderColor = '#32d0cb';
    }
  });
  
  form.addEventListener('submit', function(event) {
    let isValid = true;
    
    if (!validateField(document.getElementById('fullname'))) isValid = false;
    if (!validateEmail(document.getElementById('email'))) isValid = false;
    if (!validatePhone(document.getElementById('phone'))) isValid = false;
    if (!validateField(document.getElementById('password'))) isValid = false;
    if (!validatePasswordMatch(document.getElementById('password'), document.getElementById('confirmPassword'))) isValid = false;
    
    if (!isValid) {
      event.preventDefault();
      const firstError = document.querySelector('[style*="border-color: #dc2626"]');
      if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });