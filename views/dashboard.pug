doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Inventory Dashboard
    link(rel='stylesheet' href='/css/dashboard.css')


  body
    .dashboard-container
      .top-section
        .stats-container
          .card.sales-orders-card
            .stat-group
              .stat-number UGX 50,000,000
              .stat-label Sales
            .divider
            .stat-group.padding-left
              .stat-number UGX 15,000,000
              .stat-label Orders
          .split-cards-row
            .card.stock-card
              .stat-number.text-green UGX #{totalStockValue.toLocaleString()}
              .stat-label In stock
            .card.stock-card
              .stat-number.text-red.large-text 5
              .stat-label Out of stock
        .card.form-card
          // Success message at the top (inside card, above title)
          if success
            .success-message
              span #{success}
          
          // Error message inside the card
          if error
            .error-message
              span #{error}
          
          h3.form-title Add Product
          
          form.product-form(id='productForm' action='/add-product' method='POST' enctype='multipart/form-data')
            .form-group
              input.form-input(type='text' id='productName' name='productName' placeholder='Product Name')
              .field-error(id='productNameError')
            
            .form-group
              input.form-input(type='text' id='category' name='category' placeholder='Category')
              .field-error(id='categoryError')
            
            .form-group
              input.form-input(type='number' id='price' name='price' placeholder='Price')
              .field-error(id='priceError')
            
            .form-group
              input.form-input(type='number' id='quantity' name='quantity' placeholder='Quantity')
              .field-error(id='quantityError')
            
            .form-row
              .form-group
                input.form-input(type='text' id='color' name='color' placeholder='Color')
                .field-error(id='colorError')
              .form-group
                input.upload-btn(type='file' id='productImage' name='productImage' accept='image/*')
                .field-error(id='imageError')
            
            .form-row.actions-row
              button.btn.btn-save(type='submit') SAVE
              button.btn.btn-clear(type='reset') CLEAR

      .table-container
        table.inventory-table
          thead
            tr
              th(style='width: 15%;') ID
              th(style='width: 30%;') Name
              th(style='width: 20%;') Category
              th(style='width: 20%;') Price (UGX)
              th(style='width: 15%;') Quantity
          tbody
            if products && products.length > 0
              each product in products
                tr
                  td #{product._id.toString().slice(-6)}
                  td #{product.productName}
                  td #{product.category}
                  td #{product.price.toLocaleString()}
                  td #{product.quantity}
            else
              tr
                td #645341
                td Sumsang s25+ Ultra
                td Smart Phones
                td 6,900,000
                td 981
              tr
                td #645346
                td Gucci XXL Shirt
                td Fashion
                td 500,000
                td 100
              tr
                td #645342
                td XL Zara Shirt
                td Fashion
                td 600,000
                td 56
              tr
                td #645344
                td iPhone 15
                td Smart Phones
                td 7,900,000
                td 752
              tr
                td #645343
                td Smart home Curtain
                td Interior Design
                td 500,000
                td 30
              tr
                td #645345
                td Spectrum Laptop 14.6 Inc
                td Laptops
                td 15,800,000
                td 144

  // Client-side validation script
  script.
    const form = document.getElementById('productForm');
    
    // Clear all previous errors
    function clearAllErrors() {
      const allTextInputs = document.querySelectorAll('.form-input');
      const fileInput = document.getElementById('productImage');
      const allErrorFields = document.querySelectorAll('.field-error');
      
      allTextInputs.forEach(input => {
        input.classList.remove('error');
      });
      
      if (fileInput) {
        fileInput.classList.remove('error');
      }
      
      allErrorFields.forEach(errorField => {
        errorField.textContent = '';
      });
    }
    
    // Validate text field (required)
    function validateTextField(field, errorField) {
      if (!field.value.trim()) {
        field.classList.add('error');
        errorField.textContent = 'Invalid field';
        return false;
      } else {
        field.classList.remove('error');
        errorField.textContent = '';
        return true;
      }
    }
    
    // Validate number field (required and > 0)
    function validateNumberField(field, errorField) {
      const value = parseFloat(field.value);
      if (!field.value.trim()) {
        field.classList.add('error');
        errorField.textContent = 'Invalid field';
        return false;
      } else if (isNaN(value) || value <= 0) {
        field.classList.add('error');
        errorField.textContent = 'Invalid field';
        return false;
      } else {
        field.classList.remove('error');
        errorField.textContent = '';
        return true;
      }
    }
    
    // Validate file field (required)
    function validateFileField(field, errorField) {
      if (field.files.length === 0) {
        field.classList.add('error');
        errorField.textContent = 'Invalid field';
        return false;
      } else {
        field.classList.remove('error');
        errorField.textContent = '';
        return true;
      }
    }
    
    // Form submission validation
    form.addEventListener('submit', function(event) {
      // Clear all previous errors first
      clearAllErrors();
      
      let isValid = true;
      
      // Validate Product Name
      if (!validateTextField(document.getElementById('productName'), document.getElementById('productNameError'))) {
        isValid = false;
      }
      
      // Validate Category
      if (!validateTextField(document.getElementById('category'), document.getElementById('categoryError'))) {
        isValid = false;
      }
      
      // Validate Price
      if (!validateNumberField(document.getElementById('price'), document.getElementById('priceError'))) {
        isValid = false;
      }
      
      // Validate Quantity
      if (!validateNumberField(document.getElementById('quantity'), document.getElementById('quantityError'))) {
        isValid = false;
      }
      
      // Validate Color
      if (!validateTextField(document.getElementById('color'), document.getElementById('colorError'))) {
        isValid = false;
      }
      
      // Validate Image
      if (!validateFileField(document.getElementById('productImage'), document.getElementById('imageError'))) {
        isValid = false;
      }
      
      // If form is invalid, prevent submission and scroll to form card
      if (!isValid) {
        event.preventDefault();
        document.querySelector('.form-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    
    // Clear button resets all errors
    document.querySelector('.btn-clear').addEventListener('click', function() {
      setTimeout(() => {
        clearAllErrors();
        document.getElementById('productImage').value = '';
      }, 100);
    });
    
    // Auto-hide success message after 5 seconds
    setTimeout(function() {
      const successMsg = document.querySelector('.success-message');
      if (successMsg) {
        setTimeout(function() {
          successMsg.style.display = 'none';
        }, 5000);
      }
    }, 100);